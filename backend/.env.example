# ==========================================
# DLP Sistemi - Ortam Değişkenleri Örneği
# Bu dosyayı .env olarak kopyalayıp düzenleyin
# ==========================================

# --------------------------
# Güvenlik Ayarları
# --------------------------
# Güçlü, rastgele üretilmiş gizli anahtar (en az 32 karakter)
SECRET_KEY=dlp-super-gizli-anahtar-degistirin-32-karakter-minimum
ALGORITHM=HS256
# Token geçerlilik süresi (dakika)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --------------------------
# Veritabanı Ayarları
# --------------------------
# SQLite (varsayılan - geliştirme ortamı)
DATABASE_URL=sqlite:///./dlp_database.db
# PostgreSQL örneği (üretim ortamı için):
# DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/dlp_db

# --------------------------
# E-posta (SMTP) Ayarları
# --------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dlp-bildirim@sirket.com
SMTP_PASSWORD=e-posta-sifreniz
SMTP_FROM=DLP Sistemi <dlp-bildirim@sirket.com>
# TLS kullan (True/False)
SMTP_USE_TLS=True

# --------------------------
# Google Workspace Entegrasyonu
# --------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# Google service account JSON dosyasının yolu (Drive/Gmail API için)
GOOGLE_SERVICE_ACCOUNT_FILE=google_service_account.json

# --------------------------
# Microsoft 365 Entegrasyonu
# --------------------------
MS_TENANT_ID=your-microsoft-tenant-id
MS_CLIENT_ID=your-microsoft-client-id
MS_CLIENT_SECRET=your-microsoft-client-secret
MS_REDIRECT_URI=http://localhost:8000/api/integrations/microsoft/callback

# --------------------------
# Tarama Ayarları
# --------------------------
# Otomatik tarama aralığı (dakika, 0=devre dışı)
SCAN_INTERVAL_MINUTES=60
# Maksimum taranacak dosya boyutu (MB)
MAX_FILE_SIZE_MB=50
# Paralel tarama iş parçacığı sayısı
SCAN_WORKER_THREADS=4

# --------------------------
# Varsayılan Yönetici Hesabı
# --------------------------
DEFAULT_ADMIN_EMAIL=admin@dlp.local
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_NAME=Sistem Yöneticisi

# --------------------------
# Uygulama Ayarları
# --------------------------
APP_NAME=DLP Güvenlik Sistemi
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# --------------------------
# CORS Ayarları
# --------------------------
# Virgülle ayrılmış izin verilen originler
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# --------------------------
# Webhook Ayarları (Opsiyonel)
# --------------------------
WEBHOOK_SECRET=webhook-gizli-anahtar
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/your-webhook-url
